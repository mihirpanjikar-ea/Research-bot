# Copy this file to .env and fill in the required values.

# --- Required ---
OPENAI_API_KEY=
EXA_API_KEY=

# --- Optional: LangSmith tracing ---
LANGSMITH_TRACING_V2=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=Research-bot

# --- Persistence ---
# Path to the SQLite checkpointing database.
# Relative paths are resolved from the working directory (src/).
SQLITE_DB_PATH=checkpoints.db

# --- Loop & safety limits ---
# Max times triage may fall back before skipping extraction.
MAX_TRIAGE_FALLBACK_ATTEMPTS=1
# Max competitors processed in parallel via Send API.
MAX_PARALLEL_COMPETITORS=3
# Max targeted Exa searches per competitor with missing data.
MAX_REMEDIATION_ATTEMPTS=2
# Max HITL feedback cycles before auto-finalising.
MAX_HITL_ITERATIONS=2

# --- Context management ---
# Rolling summarisation fires when historical context exceeds this token budget.
# Chars budget is computed as MAX_HISTORY_TOKENS * 4 (heuristic: 1 token ~= 4 chars).
MAX_HISTORY_TOKENS=2048

# --- Recency filters ---
# Exa search results older than this many days are excluded from Track B / HITL research.
RECENCY_CUTOFF_DAYS=365
# Fields with signals older than this many months are flagged as stale.
STALE_SIGNAL_THRESHOLD_MONTHS=18
